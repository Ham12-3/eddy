{
  "name": "@eddy/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "uv run --package eddy-api python -m eddy_api.openapi openapi.json && openapi-typescript openapi.json --output src/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
