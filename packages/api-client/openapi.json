        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Nodes",
        "tags": [
          "curriculum"
        ]
      }
    },
    "/v1/curriculum/nodes/{code}": {
      "get": {
        "operationId": "getCurriculumNode",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No node has this code."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Node",
        "tags": [
          "curriculum"
        ]
      }
    },
