{
  "name": "eddy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && concurrently --names web,api,maths --prefix-colors blue,green,magenta \"pnpm --filter @eddy/web dev\" \"pnpm dev:api\" \"pnpm dev:maths\"",
    "dev:api": "uv run --package eddy-api uvicorn eddy_api.main:app --reload --port 8300",
    "dev:maths": "uv run --package eddy-maths-core uvicorn eddy_maths_core.main:app --reload --port 8310",
    "keys:dev": "node scripts/dev-keys.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:py",
    "check:py": "uv run ruff check . && uv run ruff format --check . && uv run mypy && uv run pytest",
    "lint": "eslint && pnpm -r lint && prettier --check . && node scripts/check-dashes.mjs",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test && node --test \".claude/hooks/*.test.mjs\"",
    "format": "prettier --write . && uv run ruff format .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "api-client:generate": "pnpm --filter @eddy/api-client generate",
    "evals": "node scripts/evals.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
