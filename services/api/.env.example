# Copy of the keys `pnpm keys:dev` writes to services/api/.env (values here are placeholders).
SERVICE_TOKEN_PUBLIC_KEY_B64=base64-of-the-matching-SPKI-PEM-public-key
DATABASE_URL=postgresql+psycopg://eddy:eddy@127.0.0.1:5442/eddy
MATHS_CORE_BASE_URL=http://127.0.0.1:8310
MATHS_CORE_SERVICE_TOKEN=shared-random-token
SCENE_CHECK_BASE_URL=http://127.0.0.1:8320
SCENE_CHECK_SERVICE_TOKEN=shared-random-token
# development, test or production (the default). Only development and test allow the local
# database ZDR exception and the tutor's unapproved safeguarding draft.
EDDY_ENVIRONMENT=development
# Add your own key here (pnpm keys:dev never writes it). Without it, Tier L scenes are off.
ANTHROPIC_API_KEY=
# Optional cost guards for Tier L (defaults shown).
# TIER_L_CALLS_PER_STUDENT_PER_DAY=12
# TIER_L_DAILY_BUDGET_GBP=5.0
# Set to true only once zero data retention is confirmed with Anthropic (SPEC.md section 10).
# Until then Claude runs only against a local database, in development or test.
# ANTHROPIC_ZDR_CONFIRMED=false
# Optional: REDIS_URL (default redis://127.0.0.1:6390/0), TUTOR_MESSAGES_PER_MINUTE (12),
# TUTOR_MESSAGES_PER_DAY (400).
# Optional tutor cost guards: TUTOR_GBP_PER_STUDENT_PER_DAY (0.5), TUTOR_DAILY_BUDGET_GBP (20),
# and TUTOR_CONCURRENT_TURNS (4) per process.
# LangSmith tracing is always switched off: LANGSMITH_TRACING and LANGCHAIN_TRACING_V2 are
# forced to false, as lesson state must not leave Eddy's processors (SPEC.md section 12).
