# Copy of the keys `pnpm keys:dev` writes to apps/web/.env.local (values here are placeholders).
API_BASE_URL=http://127.0.0.1:8300
SERVICE_TOKEN_PRIVATE_KEY_B64=base64-of-a-PKCS8-PEM-P-256-private-key
# Auth.js (ADR-0008, ADR-0032): signs its cookies and the sign-up steps' cookie.
AUTH_SECRET=a-long-random-secret
# Where sign-in links point: the address you open the app at.
AUTH_URL=http://localhost:3300
# Sign-in email: Mailpit locally (read it at http://127.0.0.1:8025), Amazon SES in production.
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=Eddy <sign-in@eddy.localhost>
