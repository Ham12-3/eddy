{
  "name": "@eddy/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Eddy desktop app (ADR-0036): one window, and every service on this computer.",
  "main": "src/main.mjs",
  "scripts": {
    "build": "pnpm build:shell && pnpm build:scene-check && pnpm build:web && pnpm build:python && pnpm build:postgres",
    "build:shell": "node scripts/build-shell.mjs",
    "build:scene-check": "node scripts/build-scene-check.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:python": "node scripts/build-python.mjs",
    "build:postgres": "node scripts/fetch-postgres.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "test:app": "node --test \"src/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
