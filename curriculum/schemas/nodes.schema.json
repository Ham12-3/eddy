{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eddy:curriculum:nodes",
  "title": "Curriculum nodes: one per DfE subject content statement (ADR-0021)",
  "type": "object",
  "required": ["spec", "strands"],
  "additionalProperties": false,
  "properties": {
    "spec": { "$ref": "urn:eddy:curriculum:common#/$defs/specRef" },
    "strands": {
      "type": "object",
      "propertyNames": {
        "enum": ["NUMBER", "ALGEBRA", "RATIO", "GEOMETRY", "PROBABILITY", "STATISTICS"]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["code", "tier", "visual", "title", "description"],
          "additionalProperties": false,
          "properties": {
            "code": { "$ref": "urn:eddy:curriculum:common#/$defs/nodeCode" },
            "tier": { "enum": ["FOUNDATION", "HIGHER_ONLY"] },
            "visual": { "type": "integer", "minimum": 1, "maximum": 3 },
            "title": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" },
            "description": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" },
            "higher": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" }
          }
        }
      }
    }
  }
}
