{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eddy:curriculum:question_types",
  "title": "English question types and paraphrased level descriptors",
  "type": "object",
  "required": ["level_sets", "question_types"],
  "additionalProperties": false,
  "properties": {
    "level_sets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{1,63}$" },
      "additionalProperties": {
        "description": "Level 1 first. Language uses four levels; Literature essays use six.",
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" }
      }
    },
    "question_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["spec", "paper", "number", "marks", "aos", "minutes", "task"],
        "additionalProperties": false,
        "properties": {
          "spec": { "$ref": "urn:eddy:curriculum:common#/$defs/specRef" },
          "paper": { "type": "integer", "minimum": 1, "maximum": 9 },
          "number": { "type": "string", "pattern": "^[A-Z0-9]{1,8}$" },
          "marks": { "type": "integer", "minimum": 1, "maximum": 100 },
          "aos": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AO[1-6]$" }
          },
          "minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
          "levels": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "task": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" }
        }
      }
    }
  }
}
