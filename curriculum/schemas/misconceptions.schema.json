{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eddy:curriculum:misconceptions",
  "title": "The misconception library, with detection rules in the rule language (ADR-0022)",
  "type": "object",
  "required": ["misconceptions"],
  "additionalProperties": false,
  "properties": {
    "misconceptions": {
      "type": "array",
      "minItems": 60,
      "items": {
        "type": "object",
        "required": [
          "code",
          "node",
          "title",
          "student",
          "teacher",
          "detect",
          "scene",
          "recheck",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "node": { "$ref": "urn:eddy:curriculum:common#/$defs/nodeCode" },
          "title": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" },
          "student": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" },
          "teacher": { "$ref": "urn:eddy:curriculum:common#/$defs/prose" },
          "detect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "rule"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "enum": ["distractor", "structure"] },
                    "rule": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
                  }
                },
                {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": { "type": { "const": "classifier" } }
                }
              ]
            }
          },
          "scene": { "$ref": "urn:eddy:curriculum:common#/$defs/sceneTemplate" },
          "recheck": {
            "type": "string",
            "pattern": "^[NARGPS][1-9][0-9]?\\.[a-z0-9][a-z0-9-]{1,63}$"
          },
          "evidence": {
            "anyOf": [
              { "enum": ["brief-s2", "practice"] },
              { "type": "string", "pattern": "^https://" }
            ]
          }
        }
      }
    }
  }
}
