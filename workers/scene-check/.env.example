# Copy of the keys `pnpm keys:dev` writes to workers/scene-check/.env (values here are placeholders).
SCENE_CHECK_SERVICE_TOKEN=shared-random-token
# Optional: SCENE_CHECK_HOST (default 127.0.0.1) and SCENE_CHECK_PORT (default 8320).
# Optional: SCENE_CHECK_CHROMIUM_SANDBOX=1 turns on Chromium's own sandbox (needed in production).
